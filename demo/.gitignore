# ABOUTME: Demo-local gitignore. Mirrored at the repo root for safety.
# ABOUTME: Anything generated by setup.sh lives under .local/ and is never committed.

# Ephemeral runtime artifacts (entire .local/ tree)
.local/

# Catch any stray credential files outside .local/
*.kubeconfig
*.token
agent-token

# Backup video (lives on USB stick, never in git)
*.mp4
*.mov

# Test outputs
test-results/
